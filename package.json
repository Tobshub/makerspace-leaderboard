{
  "name": "makerspace-leaderboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.8.0",
  "scripts": {
    "dev": "vite --port=3001 --host=0.0.0.0",
    "dev:api": "wrangler dev --port=8787",
    "build": "pnpm lint && vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit && tsc --noEmit -p worker",
    "deploy": "pnpm build && wrangler deploy",
    "cf-types": "wrangler types worker/worker-configuration.d.ts"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "wrangler": "^4.147.0"
  }
}
